@page
@model GalleryModel
@{
    ViewData["Title"] = "Galerie foto";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>
        <i class="fas fa-images text-primary"></i>
        Galerie foto
    </h2>
    
    <div class="d-flex gap-2">
        <div class="dropdown">
            <button class="btn btn-outline-secondary dropdown-toggle" type="button" data-bs-toggle="dropdown">
                <i class="fas fa-filter"></i>
                @(Model.SelectedCategory.HasValue ? GetCategoryName(Model.SelectedCategory.Value) : "Toate categoriile")
            </button>
            <ul class="dropdown-menu">
                <li><a class="dropdown-item" asp-page="/Gallery">📷 Toate categoriile</a></li>
                <li><a class="dropdown-item" asp-page="/Gallery" asp-route-category="0">🌿 Natură</a></li>
                <li><a class="dropdown-item" asp-page="/Gallery" asp-route-category="1">🏢 Clădiri</a></li>
                <li><a class="dropdown-item" asp-page="/Gallery" asp-route-category="2">🐾 Animale</a></li>
                <li><a class="dropdown-item" asp-page="/Gallery" asp-route-category="3">👤 Portrete</a></li>
                <li><a class="dropdown-item" asp-page="/Gallery" asp-route-category="4">🎨 Abstract</a></li>
            </ul>
        </div>
        
        @if (HttpContext.Session.IsLoggedIn())
        {
            <a asp-page="/Upload" class="btn btn-primary">
                <i class="fas fa-plus"></i> Încarcă poză
            </a>
        }
    </div>
</div>

@if (Model.Photos.Any())
{
    <div class="photo-grid">
        @foreach (var photo in Model.Photos)
        {
            <div class="card photo-card" onclick="goToPhoto(@photo.Id)">
                <div class="position-relative">
                    <img src="~/uploads/@photo.FileName" class="card-img-top" alt="@photo.Title" 
                         style="height: 250px; object-fit: cover;">
                    <div class="position-absolute top-0 end-0 p-2">
                        <span class="badge bg-primary">@GetCategoryEmoji(photo.Category)</span>
                    </div>
                </div>
                <div class="card-body">
                    <h6 class="card-title">@photo.Title</h6>
                    @if (!string.IsNullOrEmpty(photo.Description))
                    {
                        <p class="card-text text-muted small">
                            @(photo.Description.Length > 100 ? photo.Description.Substring(0, 100) + "..." : photo.Description)
                        </p>
                    }
                    <div class="d-flex justify-content-between align-items-center">
                        <small class="text-muted">
                            <i class="fas fa-user"></i> @photo.User.Name
                        </small>
                        <div class="btn-group" role="group">
                            @if (HttpContext.Session.IsLoggedIn())
                            {
                                <button onclick="event.stopPropagation(); likePhoto(@photo.Id)" 
                                        class="btn btn-outline-danger btn-sm like-btn" 
                                        id="likeBtn-@photo.Id" 
                                        data-photo-id="@photo.Id">
                                    <i class="far fa-heart"></i> <span class="like-count">@photo.Likes</span>
                                </button>
                            }
                            else
                            {
                                <button class="btn btn-outline-danger btn-sm" disabled title="Trebuie să te autentifici pentru a aprecia">
                                    <i class="far fa-heart"></i> @photo.Likes
                                </button>
                            }
                            <button onclick="event.stopPropagation(); goToPhoto(@photo.Id)" class="btn btn-primary btn-sm">
                                <i class="fas fa-eye"></i> Vezi
                            </button>
                        </div>
                    </div>
                    <small class="text-muted d-block mt-2">
                        <i class="fas fa-clock"></i> @photo.UploadedAt.ToString("dd MMM yyyy")
                        <span class="ms-2">
                            <i class="fas fa-eye"></i> @photo.Views vizualizări
                        </span>
                    </small>
                </div>
            </div>
        }
    </div>
}
else
{
    <div class="text-center py-5">
        <i class="fas fa-images fa-5x text-muted mb-4"></i>
        <h4 class="text-muted">Nu există poze în această categorie</h4>
        <p class="text-muted">
            @if (HttpContext.Session.IsLoggedIn())
            {
                <text>Fii primul care încarcă o poză!</text>
            }
            else
            {
                <text>Înregistrează-te pentru a încărca poze.</text>
            }
        </p>
        @if (HttpContext.Session.IsLoggedIn())
        {
            <a asp-page="/Upload" class="btn btn-primary">
                <i class="fas fa-upload"></i> Încarcă prima poză
            </a>
        }
        else
        {
            <a asp-page="/Register" class="btn btn-success">
                <i class="fas fa-user-plus"></i> Înregistrează-te
            </a>
        }
    </div>
}

<style>
    /* Like button animations */
    .btn.like-btn {
        transition: all 0.3s ease;
    }
    
    .btn.like-btn.liked {
        animation: heartBeat 0.5s ease;
    }
    
    @@keyframes heartBeat {
        0% { transform: scale(1); }
        25% { transform: scale(1.15); }
        50% { transform: scale(1.05); }
        75% { transform: scale(1.15); }
        100% { transform: scale(1); }
    }
    
    @@keyframes slideInFromRight {
        from { transform: translateX(100%); opacity: 0; }
        to { transform: translateX(0); opacity: 1; }
    }
    
    @@keyframes slideOutToRight {
        from { transform: translateX(0); opacity: 1; }
        to { transform: translateX(100%); opacity: 0; }
    }
    
    @@keyframes fadeIn {
        from { opacity: 0; transform: translateY(20px); }
        to { opacity: 1; transform: translateY(0); }
    }
    
    @@keyframes pulse {
        0%, 100% { transform: scale(1); }
        50% { transform: scale(1.05); }
    }
    
    @@keyframes slideInUp {
        from { opacity: 0; transform: translateY(30px); }
        to { opacity: 1; transform: translateY(0); }
    }
    
    .photo-notification {
        animation: slideInFromRight 0.3s ease-out;
    }
</style>

<script>
    function goToPhoto(photoId) {
        window.location.href = `/Photo/${photoId}`;
    }

    // Toggle like function - ENHANCED
    async function likePhoto(photoId) {
        const button = document.getElementById(`likeBtn-${photoId}`);
        const originalText = button.innerHTML;
        
        // Show loading state
        button.innerHTML = '<i class="fas fa-spinner fa-spin"></i> <span class="like-count">...</span>';
        button.disabled = true;

        try {
            const response = await fetch(`/api/photos/${photoId}/like`, {
                method: 'POST'
            });
            
            if (response.ok) {
                const result = await response.json();
                button.innerHTML = `<i class="fas fa-heart"></i> <span class="like-count">${result.likes}</span>`;
                button.classList.add('liked');
                setTimeout(() => button.classList.remove('liked'), 500);
            } else {
                button.innerHTML = originalText;
            }
        } catch (error) {
            button.innerHTML = originalText;
        } finally {
            button.disabled = false;
        }
    }
</script>

@functions {
    private string GetCategoryName(PhotoCategory category)
    {
        return category switch
        {
            PhotoCategory.Natura => "Natură",
            PhotoCategory.Cladiri => "Clădiri",
            PhotoCategory.Animale => "Animale",
            PhotoCategory.Portrete => "Portrete",
            PhotoCategory.Abstract => "Abstract",
            _ => "Necunoscut"
        };
    }

    private string GetCategoryEmoji(PhotoCategory category)
    {
        return category switch
        {
            PhotoCategory.Natura => "🌿",
            PhotoCategory.Cladiri => "🏢",
            PhotoCategory.Animale => "🐾",
            PhotoCategory.Portrete => "👤",
            PhotoCategory.Abstract => "🎨",
            _ => "📷"
        };
    }
}