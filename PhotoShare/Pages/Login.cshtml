@page
@model LoginModel
@{
    ViewData["Title"] = "Autentificare";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card">
            <div class="card-header text-center">
                <h3>
                    <i class="fas fa-sign-in-alt text-primary"></i>
                    Autentificare
                </h3>
            </div>
            <div class="card-body">
                <form method="post">
                    <div asp-validation-summary="All" class="alert alert-danger" role="alert"></div>
                    
                    <div class="form-group mb-3">
                        <label asp-for="Input.Email" class="form-label">
                            <i class="fas fa-envelope"></i> Email
                        </label>
                        <input asp-for="Input.Email" class="form-control" placeholder="adresa@email.com" autocomplete="email" />
                        <span asp-validation-for="Input.Email" class="text-danger"></span>
                    </div>
                    
                    <div class="form-group mb-3">
                        <label asp-for="Input.Password" class="form-label">
                            <i class="fas fa-lock"></i> Parolă
                        </label>
                        <input asp-for="Input.Password" class="form-control" type="password" placeholder="Introdu parola" autocomplete="current-password" />
                        <span asp-validation-for="Input.Password" class="text-danger"></span>
                    </div>
                    
                    <div class="d-grid">
                        <button type="submit" class="btn btn-primary btn-lg">
                            <i class="fas fa-sign-in-alt"></i> Intră în cont
                        </button>
                    </div>
                </form>
                
                <hr>
                <div class="text-center">
                    <p>Nu ai cont?</p>
                    <a asp-page="/Register" class="btn btn-outline-success">
                        <i class="fas fa-user-plus"></i> Înregistrează-te
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>