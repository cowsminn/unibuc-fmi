@page
@model NotFoundModel
@{
    ViewData["Title"] = "Pagină nu a fost găsită";
}

<div class="container-fluid vh-100 d-flex align-items-center justify-content-center">
    <div class="text-center">
        <div class="error-container">
            <div class="error-icon mb-4">
                <i class="fas fa-search fa-8x text-muted"></i>
            </div>
            
            <h1 class="display-1 fw-bold text-primary">404</h1>
            <h2 class="h4 mb-3">Pagina nu a fost găsită</h2>
            
            <div class="alert alert-warning d-inline-block">
                <i class="fas fa-exclamation-triangle me-2"></i>
                @if (!string.IsNullOrEmpty(Model.CustomMessage))
                {
                    @Model.CustomMessage
                }
                else
                {
                    <text>Resursa pe care o căutați nu există sau a fost ștearsă.</text>
                }
            </div>

            <div class="mt-4">
                <div class="row justify-content-center">
                    <div class="col-md-8">
                        <div class="card">
                            <div class="card-body">
                                <h5 class="card-title">
                                    <i class="fas fa-lightbulb text-warning me-2"></i>
                                    Ce poți face:
                                </h5>
                                <ul class="list-unstyled text-start">
                                    <li class="mb-2">
                                        <i class="fas fa-home text-primary me-2"></i>
                                        <a asp-page="/Index" class="text-decoration-none">Mergi la pagina principală</a>
                                    </li>
                                    <li class="mb-2">
                                        <i class="fas fa-images text-success me-2"></i>
                                        <a asp-page="/Gallery" class="text-decoration-none">Explorează galeria de poze</a>
                                    </li>
                                    <li class="mb-2">
                                        <i class="fas fa-map text-info me-2"></i>
                                        <a asp-page="/MapSearch" class="text-decoration-none">Caută poze pe hartă</a>
                                    </li>
                                    @if (HttpContext.Session.IsLoggedIn())
                                    {
                                        <li class="mb-2">
                                            <i class="fas fa-cloud-upload-alt text-warning me-2"></i>
                                            <a asp-page="/Upload" class="text-decoration-none">Încarcă o poză nouă</a>
                                        </li>
                                    }
                                </ul>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="mt-4">
                <a href="javascript:history.back()" class="btn btn-outline-secondary me-2">
                    <i class="fas fa-arrow-left me-1"></i>
                    Înapoi
                </a>
                <a asp-page="/Index" class="btn btn-primary">
                    <i class="fas fa-home me-1"></i>
                    Acasă
                </a>
            </div>
        </div>
    </div>
</div>

<style>
    .error-container {
        animation: fadeInUp 0.6s ease-out;
    }
    
    .error-icon {
        animation: pulse 2s infinite;
    }
    
    .card {
        box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
        border: none;
        border-radius: 1rem;
    }
    
    .btn {
        border-radius: 2rem;
        padding: 0.5rem 1.5rem;
    }
</style>

@section Styles {
    <style>
        /* CSS animations moved here to avoid Razor conflicts */
        @@keyframes fadeInUp {
            from {
                opacity: 0;
                transform: translateY(30px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }
        
        @@keyframes pulse {
            0%, 100% {
                transform: scale(1);
            }
            50% {
                transform: scale(1.05);
            }
        }
    </style>
}
