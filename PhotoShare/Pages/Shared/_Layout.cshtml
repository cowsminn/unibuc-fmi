<!DOCTYPE html>
<html lang="ro">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - PhotoShare</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
    
    @await RenderSectionAsync("Styles", required: false)
    
    <style>
        /* Footer always at bottom */
        html, body {
            height: 100%;
        }
        
        .page-wrapper {
            min-height: 100vh;
            display: flex;
            flex-direction: column;
        }
        
        .content-wrapper {
            flex: 1;
        }
        
        .footer {
            background: rgba(255, 255, 255, 0.9);
            backdrop-filter: blur(20px);
            border-top: 1px solid rgba(255, 255, 255, 0.2);
            padding: 20px 0;
            margin-top: auto;
        }
        
        /* Clickable photo cards */
        .photo-card {
            cursor: pointer;
            transition: all 0.3s ease;
        }
        
        .photo-card:hover {
            transform: translateY(-8px);
            box-shadow: 0 15px 35px rgba(0, 0, 0, 0.2);
        }
        
        .photo-card img {
            transition: transform 0.3s ease;
        }
        
        .photo-card:hover img {
            transform: scale(1.05);
        }
    </style>
</head>
<body>
    <div class="page-wrapper">
        <header>
            <nav class="navbar navbar-expand-sm navbar-toggleable-sm border-bottom box-shadow mb-3">
                <div class="container">
                    <a class="navbar-brand" asp-area="" asp-page="/Index">
                        <i class="fas fa-camera"></i>
                        <strong>PhotoShare</strong>
                    </a>
                    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse">
                        <span class="navbar-toggler-icon"></span>
                    </button>
                    <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                        <ul class="navbar-nav flex-grow-1">
                            <li class="nav-item">
                                <a class="nav-link" asp-page="/Gallery">
                                    <i class="fas fa-images"></i> Galerie
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-page="/MapSearch">
                                    <i class="fas fa-map"></i> Căutare pe hartă
                                </a>
                            </li>
                            @if (Context.Session.IsLoggedIn())
                            {
                                <li class="nav-item">
                                    <a class="nav-link" asp-area="" asp-page="/Upload">
                                        <i class="fas fa-cloud-upload-alt"></i> Încarcă
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" asp-area="" asp-page="/MyPhotos">
                                        <i class="fas fa-user-images"></i> Pozele mele
                                    </a>
                                </li>
                            }
                        </ul>
                        <ul class="navbar-nav">
                            @if (Context.Session.IsLoggedIn())
                            {
                                <li class="nav-item dropdown">
                                    <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown">
                                        <i class="fas fa-user"></i> @Context.Session.GetString("UserName")
                                    </a>
                                    <ul class="dropdown-menu">
                                        <li><a class="dropdown-item" asp-page="/Profile"><i class="fas fa-user-cog"></i> Profil</a></li>
                                        <li><hr class="dropdown-divider"></li>
                                        <li>
                                            <a class="dropdown-item" asp-page="/Logout" onclick="return confirm('Ești sigur că vrei să te deconectezi?')">
                                                <i class="fas fa-sign-out-alt"></i> Deconectare
                                            </a>
                                        </li>
                                    </ul>
                                </li>
                            }
                            else
                            {
                                <li class="nav-item">
                                    <a class="nav-link" asp-area="" asp-page="/Login">
                                        <i class="fas fa-sign-in-alt"></i> Login
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" asp-area="" asp-page="/Register">
                                        <i class="fas fa-user-plus"></i> Înregistrare
                                    </a>
                                </li>
                            }
                        </ul>
                    </div>
                </div>
            </nav>
        </header>
        
        <div class="content-wrapper">
            <div class="container">
                <main role="main" class="pb-3">
                    @RenderBody()
                </main>
            </div>
        </div>

        <footer class="footer">
            <div class="container">
                <div class="row align-items-center">
                    <div class="col-md-6">
                        <p class="mb-0">
                            <i class="fas fa-camera"></i>
                            <strong>PhotoShare</strong> - Partajează momentele tale speciale
                        </p>
                    </div>
                    <div class="col-md-6 text-md-end">
                        <p class="mb-0">
                            &copy; @DateTime.Now.Year PhotoShare. Toate drepturile rezervate.
                        </p>
                    </div>
                </div>
            </div>
        </footer>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>